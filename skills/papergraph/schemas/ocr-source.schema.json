{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.papergraph.dev/schemas/ocr-source.schema.json",
  "title": "PaperGraph normalized OCR source",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_id",
    "provider_run_id",
    "image",
    "provider",
    "normalized_observation_sha256",
    "elements"
  ],
  "properties": {
    "schema_version": {"const": "papergraph-ocr-source/1.0"},
    "source_id": {"type": "string", "minLength": 1},
    "provider_run_id": {"type": "string", "minLength": 1},
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1}
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "action", "api_version", "request_id", "language", "angle"],
      "properties": {
        "name": {"const": "tencent-ocr"},
        "action": {"enum": ["GeneralBasicOCR", "GeneralAccurateOCR"]},
        "api_version": {"const": "2018-11-19"},
        "request_id": {"type": "string", "minLength": 1},
        "language": {"type": ["string", "null"]},
        "angle": {"type": "number"}
      }
    },
    "normalized_observation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "elements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "confidence", "polygon_norm"],
        "properties": {
          "id": {"type": "string", "pattern": "^ocr-[0-9a-f]{24}$"},
          "text": {"type": "string"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "polygon_norm": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {"type": "number", "minimum": 0, "maximum": 1}
            }
          }
        }
      }
    }
  }
}
